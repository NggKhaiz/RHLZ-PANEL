# RHLZ Panel - Server Configuration
# Main Panel Production Port
PORT=6767

# Whether to enable Docker support (true/false)
ENABLE_DOCKER=false

# Development Port (Disabled by default. Uncomment to use dev port 3000)
# PORT=3000
# VITE_ENABLE_DEV_MODE=true

# REQUIRED in production (no default secret is ever shipped). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If unset, the RHLZ Secure Core auto-generates a random secret, persists it
# to .data/secret (0600) and logs a warning. Legacy JWT_SECRET is honored as a fallback.
RHLZ_SESSION_SECRET="your-secure-random-jwt-secret-here"
# JWT_SECRET is a fallback if RHLZ_SESSION_SECRET is unset (legacy installs).

# Session-token lifetime (short-lived by default; e.g. 1h, 8h, 1d).
# RHLZ_SESSION_TTL=24h

# Memory guard: caps the V8 heap so the panel can never exceed ~128 MB RSS.
# NODE_OPTIONS=--max-old-space-size=96

# Gemini AI API Key (Optional, kept server-side)
GEMINI_API_KEY="your-gemini-api-key"

DOCKER_SOCKET_PATH=
VITE_ENABLE_DEVELOPER_PANEL=true

# ---------------------------------------------------------------------------
# Security (optional but recommended)
# ---------------------------------------------------------------------------

# GitHub auto-update webhook. When set, POST /api/webhook/github-update only
# works with a valid signature. When UNSET the webhook is disabled (503).
# GITHUB_WEBHOOK_SECRET=""

# Comma-separated list of origins allowed to call the API and open socket.io
# connections (e.g. https://panel.example.com). Same-origin requests and
# localhost (dev) are always allowed.
# PANEL_CORS_ORIGINS="https://panel.example.com"

# Enable a conservative Content-Security-Policy header in production (true/false).
# PANEL_CSP=true
